          "efficacy": 88,
          "weight": 0.9,
          "evidence_level": "High (Strong Evidence)",
          "preparation_method": "Mix 1/2 teaspoon of turmeric powder with yogurt or honey to form a paste. Apply for 10-15 minutes and rinse."
        }
